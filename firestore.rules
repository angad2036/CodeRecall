rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared primitive helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['java', 'cpp', 'python'];
    }

    function isValidStatus(status) {
      return status is string && status in ['unstarted', 'attempted', 'solved', 'mastered'];
    }

    // Entity validator: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'preferredLanguage',
          'streakDays', 'lastActiveDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'preferredLanguage',
          'streakDays', 'lastActiveDate', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && isValidLanguage(data.preferredLanguage)
        && data.streakDays is number
        && data.streakDays >= 0
        && data.streakDays <= 10000
        && data.lastActiveDate is string
        && data.lastActiveDate.size() >= 8
        && data.lastActiveDate.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity validator: ProblemProgress
    function isValidProblemProgress(data, userId, problemId) {
      return data.keys().hasAll([
          'userId', 'problemId', 'status', 'preferredLanguage',
          'recallAttempts', 'recallSuccessCount', 'lastRecallAccuracy',
          'easeFactor', 'intervalDays', 'repetitions', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'problemId', 'status', 'preferredLanguage',
          'codeJava', 'codeCpp', 'codePython', 'notes',
          'recallAttempts', 'recallSuccessCount', 'lastRecallAccuracy',
          'easeFactor', 'intervalDays', 'repetitions',
          'nextReviewAt', 'lastPracticedAt', 'createdAt', 'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.problemId is string
        && data.problemId == problemId
        && isValidId(data.problemId)
        && isValidStatus(data.status)
        && isValidLanguage(data.preferredLanguage)
        && (!('codeJava' in data) || (data.codeJava is string && data.codeJava.size() <= 25000))
        && (!('codeCpp' in data) || (data.codeCpp is string && data.codeCpp.size() <= 25000))
        && (!('codePython' in data) || (data.codePython is string && data.codePython.size() <= 25000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && data.recallAttempts is number
        && data.recallAttempts >= 0
        && data.recallAttempts <= 100000
        && data.recallSuccessCount is number
        && data.recallSuccessCount >= 0
        && data.recallSuccessCount <= data.recallAttempts
        && data.lastRecallAccuracy is number
        && data.lastRecallAccuracy >= 0
        && data.lastRecallAccuracy <= 100
        && data.easeFactor is number
        && data.easeFactor >= 1.3
        && data.easeFactor <= 5.0
        && data.intervalDays is number
        && data.intervalDays >= 0
        && data.intervalDays <= 3650
        && data.repetitions is number
        && data.repetitions >= 0
        && data.repetitions <= 10000
        && (!('nextReviewAt' in data) || data.nextReviewAt is timestamp)
        && (!('lastPracticedAt' in data) || data.lastPracticedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity validator: RecallSession
    function isValidRecallSession(data, userId) {
      return data.keys().hasAll([
          'userId', 'problemId', 'language', 'accuracyPercent',
          'passed', 'durationSeconds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'problemId', 'language', 'accuracyPercent',
          'passed', 'durationSeconds', 'createdAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && isValidId(data.problemId)
        && isValidLanguage(data.language)
        && data.accuracyPercent is number
        && data.accuracyPercent >= 0
        && data.accuracyPercent <= 100
        && data.passed is bool
        && data.durationSeconds is number
        && data.durationSeconds >= 0
        && data.durationSeconds <= 86400
        && data.createdAt is timestamp;
    }

    // Users collection: strict PII isolation (owner-only read/write, no collection listing)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'preferredLanguage',
          'streakDays', 'lastActiveDate', 'updatedAt'
        ]);

      allow delete: if false;

      // Subcollection: Per-problem progress and code buffers
      match /progress/{problemId} {
        allow get: if isValidId(userId)
          && isValidId(problemId)
          && isOwner(userId);

        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isEmailVerified()
          && isValidId(userId)
          && isValidId(problemId)
          && isOwner(userId)
          && isValidProblemProgress(incoming(), userId, problemId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isEmailVerified()
          && isValidId(userId)
          && isValidId(problemId)
          && isOwner(userId)
          && isValidProblemProgress(incoming(), userId, problemId)
          && incoming().userId == existing().userId
          && incoming().problemId == existing().problemId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'preferredLanguage', 'codeJava', 'codeCpp', 'codePython',
              'notes', 'lastPracticedAt', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'recallAttempts', 'recallSuccessCount', 'lastRecallAccuracy',
              'easeFactor', 'intervalDays', 'repetitions', 'nextReviewAt',
              'lastPracticedAt', 'updatedAt'
            ])
          );

        allow delete: if isEmailVerified()
          && isValidId(userId)
          && isValidId(problemId)
          && isOwner(userId);
      }

      // Subcollection: Append-only recall session audit log
      match /recallSessions/{sessionId} {
        allow get: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId);

        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isEmailVerified()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidRecallSession(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update, delete: if false;
      }
    }
  }
}
